# Backend base URL. Leave empty in dev (Vite proxies /api to localhost:8000).
# Production (Vercel): https://<user>-<space>.hf.space
VITE_API_URL=

# Supabase → Project Settings → API. Optional: without them login/history are hidden.
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key — never the secret key
VITE_SUPABASE_ANON_KEY=
