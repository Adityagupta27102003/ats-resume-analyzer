# Copy to .env and fill in. All are optional for local dev: without Groq the
# analyzer uses local parsing; without Supabase, login/history are disabled.

# Comma-separated, no trailing slashes
ALLOWED_ORIGINS=http://localhost:5173

# https://console.groq.com/keys
GROQ_API_KEY=

# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...) or legacy service_role key — server only, never ship to the browser
SUPABASE_KEY=
# Publishable key (sb_publishable_...) or legacy anon key
SUPABASE_ANON_KEY=

# Deploy only (never needed by the app itself)
# https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=
